# Local development only. Copy to .env and replace all three values.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-local-bootstrap-password
MAINTENANCE_DB_PASSWORD=replace-with-local-maintenance-password
INVENTORY_DB_PASSWORD=replace-with-local-inventory-password

# Optional local demo accounts. Set all four values to enable seeding.
# KESTREL_DEMO_ADMIN_PASSWORD=
# KESTREL_DEMO_MAINTENANCE_PASSWORD=
# KESTREL_DEMO_TECHNICIAN_PASSWORD=
# KESTREL_DEMO_INVENTORY_PASSWORD=

# Optional Telemetry gRPC settings. See telemetry-service/README.md for thresholds.
# TELEMETRY_PORT=9090
# TELEMETRY_MACHINE_CODES=MACHINE-001,MACHINE-002,MACHINE-003
# TELEMETRY_INITIAL_SCENARIO=NORMAL
# TELEMETRY_INTERVAL=1s
